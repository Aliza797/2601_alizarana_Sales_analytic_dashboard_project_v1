<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="sale_analytics.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure pragmas query browser" current="2"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3118"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="cleaned_data" custom_title="0" dock_id="1" table="4,12:maincleaned_data"/><dock_state state="000000ff00000000fd0000000100000002000002d60000020bfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000002d60000012d00ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="cleaned_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="1"/></sort><column_widths><column index="1" value="54"/><column index="2" value="117"/><column index="3" value="85"/><column index="4" value="85"/><column index="5" value="117"/><column index="6" value="93"/><column index="7" value="163"/><column index="8" value="93"/><column index="9" value="109"/><column index="10" value="132"/><column index="11" value="117"/><column index="12" value="93"/><column index="13" value="62"/><column index="14" value="124"/><column index="15" value="124"/><column index="16" value="101"/><column index="17" value="300"/><column index="18" value="78"/><column index="19" value="70"/><column index="20" value="70"/><column index="21" value="85"/><column index="22" value="85"/><column index="23" value="93"/><column index="24" value="62"/><column index="25" value="171"/><column index="26" value="109"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">--verify
SELECT * FROM cleaned_data
LIMIT 5;

</sql><sql name="SQL 2*">-- Total Revenue generated
SELECT SUM(sales) AS total_revenue
FROM cleaned_data;</sql><sql name="SQL 3*">-- Total profit generated
SELECT SUM(profit) AS total_profit
FROM cleaned_data;</sql><sql name="SQL 4*">-- Sales by region
SELECT region,
       SUM(sales) AS total_sales
FROM cleaned_data
GROUP BY region
ORDER BY total_sales DESC;</sql><sql name="SQL 5*">-- Profit by category
SELECT category,
       SUM(profit) AS total_profit
FROM cleaned_data
GROUP BY category
ORDER BY total_profit DESC;</sql><sql name="SQL 6*">-- Top 10 loss-making products
SELECT product_name,
       SUM(profit) AS total_loss
FROM cleaned_data
GROUP BY product_name
ORDER BY total_loss ASC
LIMIT 10;</sql><sql name="SQL 7*">-- Average profit by discount
SELECT discount,
       AVG(profit) AS avg_profit
FROM cleaned_data
GROUP BY discount
ORDER BY discount;</sql><current_tab id="6"/></tab_sql></sqlb_project>
